#!/bin/sh
# Copyright (c) 2026 Benjamin Frohman. MIT License.
#
# Local hook. Git does not version .git/hooks, so this copy lives in
# scripts/. Install with:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# What it checks:
#   lake build elaborates the Lean sources. Blueprint.lean contains
#   sorry, and Lean reports that as a warning, not a failed build.
#   This hook does not treat that warning as a proof failure, and it
#   does not claim any Hodge-conjecture statement was checked.
#   lake exe mukai must print the four certified rows.

set -e

echo "lake build"
lake build

echo "lake exe mukai"
out=$(lake exe mukai)

printf '%s\n' "$out"

expected="(1, 0, -1) square 2 primitive true
(2, 0, -1) square 4 primitive true
(0, 1, 0) square 1 primitive true
(2, 0, -2) square 8 primitive false
pairing (1, 0, -1) (-1, 0, 1) = -2
orthogonal (1, 0, -1) (0, 1, 0) = true"

if [ "$out" != "$expected" ]; then
  echo "Mukai output did not match the certified table." >&2
  exit 1
fi

echo "Mukai table matches."
